{
  "$id": "https://github.com/ifoohoo/skill-family-doc-render/schemas/pages.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pages.json",
  "description": "站点页面清单：页面顺序、导航与翻页的真源。site 块为站点元数据（渲染器不消费）。id 限文件名片段字符，顺带消除拼路径时的 shell 元字符面。",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages"],
  "properties": {
    "site": { "type": "object" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer" },
          "inPager": { "type": "boolean" }
        }
      }
    }
  }
}
