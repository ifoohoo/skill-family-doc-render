{
  "$id": "https://github.com/ifoohoo/skill-family-doc-render/schemas/pages.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pages.json",
  "description": "旧 HTML 与 markdown-v1 共用的页面清单合同。渲染器按 public-release.json 中的 format 选择对应语义。",
  "oneOf": [
    { "$ref": "#/$defs/legacy" },
    { "$ref": "#/$defs/markdownV1" }
  ],
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages"],
      "properties": {
        "site": { "type": "object" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "order"],
            "properties": {
              "id": { "$ref": "#/$defs/safeId" },
              "title": { "type": "string", "minLength": 1 },
              "order": { "type": "integer" },
              "inPager": { "type": "boolean" }
            }
          }
        }
      }
    },
    "markdownV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "groups", "pages"],
      "properties": {
        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "productKind"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "productKind": { "enum": ["plugin", "library"] }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/safeId" },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "role", "kind", "group", "order", "inPager"],
            "properties": {
              "id": { "$ref": "#/$defs/safeId" },
              "title": { "type": "string", "minLength": 1 },
              "navTitle": { "type": "string", "minLength": 1 },
              "role": { "enum": ["overview", "setup", "first-success", "maintenance", "release", "troubleshooting", "upgrade", "reference"] },
              "kind": { "enum": ["home", "task", "reference", "troubleshooting"] },
              "group": { "$ref": "#/$defs/safeId" },
              "order": { "type": "integer" },
              "inPager": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
