{
  "$id": "https://github.com/ifoohoo/skill-family-doc-render/schemas/pages.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pages.json",
  "description": "知识站页面与导航清单结构契约，支持现代 Markdown 弹性配置清单与旧 HTML 兼容清单。",
  "oneOf": [
    { "$ref": "#/$defs/legacy" },
    { "$ref": "#/$defs/modern" }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "安全标识符：首字符为字母或数字，后续仅允许字母、数字、下划线与短横线。"
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages"],
      "description": "未声明 site.format 的存量旧 HTML 注入兼容清单格式。",
      "properties": {
        "site": {
          "type": "object",
          "properties": {
            "title": false
          },
          "description": "可选的旧版站点附加说明对象（不含 title）。"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "description": "按 order 排序的旧版 HTML 页面列表。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "order"],
            "properties": {
              "id": { "$ref": "#/$defs/safeId" },
              "title": { "type": "string", "minLength": 1, "description": "导航与翻页链接显示的页面标题。" },
              "order": { "type": "integer", "description": "页面排序整数权重。" },
              "inPager": { "type": "boolean", "description": "是否加入旧版循环翻页（缺省为 true）。" }
            }
          }
        }
      }
    },
    "modern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "pages"],
      "description": "现代 Markdown 站点配置清单（兼容旧 markdown-v1 的 role/kind/order/inPager 字段）。",
      "properties": {
        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "description": "站点全局品牌标题、简短标语、可选版本与兼容定位字段。",
          "properties": {
            "title": { "type": "string", "minLength": 1, "description": "站点主名称，显示在页眉品牌区与浏览器标题后缀。" },
            "tagline": { "type": "string", "minLength": 1, "description": "显示在左侧导航顶部的简短产品标语。" },
            "description": { "type": "string", "minLength": 1, "description": "兼容旧配置的站点描述字段（与 tagline 等效）。" },
            "version": { "type": "string", "minLength": 1, "description": "可选的页眉版本胶囊展示文本（支持 @TOKEN@ 占位符）。" },
            "productKind": {
              "enum": ["plugin", "library"],
              "description": "可选的产品形态定位提示字段。"
            }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "description": "左侧目录的导航分组定义，按数组顺序渲染。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/safeId" },
              "title": { "type": "string", "minLength": 1, "description": "导航分组的显示名称。" }
            }
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "description": "站点全部页面声明，必须与 site.dir 下的 <id>.md 文件一一对应。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/safeId" },
              "title": { "type": "string", "minLength": 1, "description": "页面唯一一级标题（H1）、浏览器标题与搜索主标题。" },
              "navTitle": { "type": "string", "minLength": 1, "description": "可选的简短侧栏导航标签；省略时使用 title。" },
              "summary": { "type": "string", "minLength": 1, "description": "可选的页面摘要说明；显示于标题下方并用于搜索与描述元信息。" },
              "group": { "$ref": "#/$defs/safeId", "description": "所属导航分组的 id（在声明 groups 时使用）。" },
              "order": { "type": "integer", "description": "可选的排序整数；省略时自然沿用数组顺序。" },
              "inPager": { "type": "boolean", "description": "是否加入上下篇翻页（省略时首页默认为 false，其余页默认为 true）。" },
              "role": { "type": "string", "minLength": 1, "description": "兼容旧配置的页面职责说明字段。" },
              "kind": { "type": "string", "minLength": 1, "description": "兼容旧配置的页面版式字段。" }
            }
          }
        }
      }
    }
  }
}
