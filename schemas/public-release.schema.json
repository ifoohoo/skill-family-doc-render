{
  "$id": "https://github.com/ifoohoo/skill-family-doc-render/schemas/public-release.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "public-release.json",
  "description": "skill-family-doc-render 的渲染配置真源：谁带 site 字段就渲染谁。",
  "type": "object",
  "additionalProperties": false,
  "required": ["repos"],
  "properties": {
    "owner": { "type": "string", "minLength": 1 },
    "defaultBranch": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "tagPrefix": { "type": "string", "minLength": 1 },
          "site": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dir", "target", "pages"],
            "properties": {
              "dir": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "pages": { "type": "string", "minLength": 1 },
              "format": { "const": "markdown-v1" },
              "template": { "const": "editorial" },
              "coverage": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lock", "inputs"],
                "properties": {
                  "lock": { "type": "string", "minLength": 1, "pattern": "^[^*?\\[\\]{}()!]+$" },
                  "inputs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1, "pattern": "^[^?\\[\\]{}()!]+$" }
                  }
                }
              },
              "versionSources": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "pattern": "^@[A-Z0-9_]+@$" },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source", "pointer"],
                  "properties": {
                    "source": { "type": "string", "minLength": 1, "pattern": "^[^*?\\[\\]{}()!]+$" },
                    "pointer": { "type": "string", "pattern": "^/" },
                    "prefix": { "type": "string" },
                    "suffix": { "type": "string" }
                  }
                }
              },
              "tokens": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
                }
              }
            },
            "dependentRequired": {
              "format": ["template"],
              "template": ["format"]
            }
          }
        }
      }
    },
    "forbiddenPublicPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "privateLiterals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
