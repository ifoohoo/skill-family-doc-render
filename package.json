{
  "name": "skill-family-doc-render",
  "version": "0.4.5",
  "description": "Config-driven GitHub Pages knowledge-site renderer for skill-family projects (multi-repo capable).",
  "author": "广州市风荷科技有限公司",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "bin": {
    "skill-family-doc-render": "bin/skill-family-doc-render.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "schemas",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "render:site": "node bin/skill-family-doc-render.mjs",
    "render:site:check": "node bin/skill-family-doc-render.mjs --check"
  },
  "dependencies": {
    "marked": "18.0.11",
    "skill-family-contracts": "0.19.3",
    "skill-family-harness-node": "0.19.3"
  }
}
